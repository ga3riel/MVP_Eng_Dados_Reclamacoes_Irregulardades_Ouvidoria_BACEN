{
  "datasets": [
    {
      "name": "irr_top",
      "displayName": "Top Irregularidades",
      "queryLines": [
        "SELECT\n",
        "  instituicao_financeira,\n",
        "  total_procedentes\n",
        "FROM\n",
        "  workspace.bacen_gold.evolucao_irregularidades_instituicao\n",
        "WHERE\n",
        "  (ano, trimestre) IN (\n",
        "    SELECT\n",
        "      MAX(ano),\n",
        "      MAX(trimestre)\n",
        "    FROM\n",
        "      workspace.bacen_gold.evolucao_irregularidades_instituicao\n",
        "    WHERE\n",
        "      ano\n",
        "        = (\n",
        "          SELECT\n",
        "            MAX(ano)\n",
        "          FROM\n",
        "            workspace.bacen_gold.evolucao_irregularidades_instituicao\n",
        "        )\n",
        "  )\n",
        "ORDER BY\n",
        "  total_procedentes DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ouv_ranking",
      "displayName": "Ranking Ouvidorias 2021 T4",
      "queryLines": [
        "SELECT\n",
        "  ranking_nota,\n",
        "  categoria,\n",
        "  instituicao_financeira,\n",
        "  nota_final,\n",
        "  nota_prazo,\n",
        "  nota_qualidade,\n",
        "  tempo_medio_respostas\n",
        "FROM\n",
        "  workspace.bacen_gold.ranking_ouvidorias\n",
        "WHERE\n",
        "  ano = 2021\n",
        "  AND periodo = 4\n",
        "  AND tipo_periodo = 'T'\n",
        "ORDER BY\n",
        "  ranking_nota\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "irr_ranking",
      "displayName": "Ranking Irregularidades",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN irregularidade LIKE 'Insatisfação com o atendimento%' THEN 'Atendimento/SAC'\n",
        "    WHEN irregularidade LIKE 'Oferta ou prestação de informação%' THEN 'Informação Inadequada'\n",
        "    WHEN irregularidade LIKE 'Débito em conta%' THEN 'Débitos Não Autorizados'\n",
        "    WHEN irregularidade LIKE '%SCR%' THEN 'SCR/Informações de Crédito'\n",
        "    WHEN irregularidade LIKE '%conta de pagamento%' THEN 'Contas e Pagamentos'\n",
        "    WHEN irregularidade LIKE '%cartões de crédito%' THEN 'Cartões de Crédito'\n",
        "    WHEN irregularidade LIKE '%crédito consignado%' THEN 'Crédito Consignado'\n",
        "    WHEN irregularidade LIKE '%crédito%' THEN 'Crédito (Outros)'\n",
        "    ELSE 'Outros'\n",
        "  END AS super_categoria,\n",
        "  irregularidade,\n",
        "  total_procedentes,\n",
        "  qtd_instituicoes\n",
        "FROM\n",
        "  workspace.bacen_gold.top_irregularidades_periodo\n",
        "WHERE\n",
        "  (ano, trimestre) IN (\n",
        "    SELECT\n",
        "      MAX(ano),\n",
        "      MAX(trimestre)\n",
        "    FROM\n",
        "      workspace.bacen_gold.top_irregularidades_periodo\n",
        "    WHERE\n",
        "      ano\n",
        "        = (\n",
        "          SELECT\n",
        "            MAX(ano)\n",
        "          FROM\n",
        "            workspace.bacen_gold.top_irregularidades_periodo\n",
        "        )\n",
        "  )\n",
        "ORDER BY\n",
        "  rank_periodo\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "irr_evolucao",
      "displayName": "Evolução Irregularidades",
      "queryLines": [
        "SELECT\n",
        "  ano,\n",
        "  categoria,\n",
        "  total_procedentes\n",
        "FROM\n",
        "  workspace.bacen_gold.resumo_irregularidades_anual\n",
        "ORDER BY\n",
        "  ano,\n",
        "  categoria"
      ]
    },
    {
      "name": "ouv_evolucao",
      "displayName": "Evolução Ouvidorias",
      "queryLines": [
        "SELECT\n",
        "  ano,\n",
        "  categoria,\n",
        "  total_respostas\n",
        "FROM\n",
        "  workspace.bacen_gold.resumo_ouvidorias_anual\n",
        "ORDER BY\n",
        "  ano,\n",
        "  categoria"
      ]
    },
    {
      "name": "rec_evolucao",
      "displayName": "Evolução Reclamações",
      "queryLines": [
        "SELECT\n",
        "  ano,\n",
        "  categoria,\n",
        "  total_reclamacoes\n",
        "FROM\n",
