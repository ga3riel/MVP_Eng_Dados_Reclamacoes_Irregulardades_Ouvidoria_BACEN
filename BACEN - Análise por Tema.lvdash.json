        "ORDER BY\n",
        "  ano,\n",
        "  categoria"
      ]
    },
    {
      "name": "rec_top",
      "displayName": "Top Reclamações 2026 T2",
      "queryLines": [
        "SELECT\n",
        "  instituicao_financeira,\n",
        "  qtd_reclamacoes,\n",
        "  categoria\n",
        "FROM\n",
        "  workspace.bacen_gold.ranking_reclamacoes\n",
        "WHERE\n",
        "  ano = 2026\n",
        "  AND trimestre = 2\n",
        "ORDER BY\n",
        "  qtd_reclamacoes DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "rec_ranking",
      "displayName": "Ranking Reclamações 2026 T2",
      "queryLines": [
        "SELECT\n",
        "  ranking_periodo,\n",
        "  categoria,\n",
        "  instituicao_financeira,\n",
        "  qtd_reclamacoes,\n",
        "  taxa_reclamacoes_por_milhao,\n",
        "  indice\n",
        "FROM\n",
        "  workspace.bacen_gold.ranking_reclamacoes\n",
        "WHERE\n",
        "  ano = 2026\n",
        "  AND trimestre = 2\n",
        "ORDER BY\n",
        "  ranking_periodo\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "ouv_top",
      "displayName": "Top Ouvidorias 2021 T4",
      "queryLines": [
        "SELECT\n",
        "  instituicao_financeira,\n",
        "  nota_final\n",
        "FROM\n",
        "  workspace.bacen_gold.ranking_ouvidorias\n",
        "WHERE\n",
        "  ano = 2021\n",
        "  AND periodo = 4\n",
        "  AND tipo_periodo = 'T'\n",
        "ORDER BY\n",
        "  nota_final DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "irr_super",
      "displayName": "Super Categorias Irregularidades",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN irregularidade LIKE 'Insatisfação com o atendimento%' THEN 'Atendimento/SAC'\n",
        "    WHEN irregularidade LIKE 'Oferta ou prestação de informação%' THEN 'Informação Inadequada'\n",
        "    WHEN irregularidade LIKE 'Débito em conta%' THEN 'Débitos Não Autorizados'\n",
        "    WHEN irregularidade LIKE '%SCR%' THEN 'SCR/Informações de Crédito'\n",
        "    WHEN irregularidade LIKE '%conta de pagamento%' THEN 'Contas e Pagamentos'\n",
        "    WHEN irregularidade LIKE '%cartões de crédito%' THEN 'Cartões de Crédito'\n",
        "    WHEN irregularidade LIKE '%crédito consignado%' THEN 'Crédito Consignado'\n",
        "    WHEN irregularidade LIKE '%crédito%' THEN 'Crédito (Outros)'\n",
        "    ELSE 'Outros'\n",
        "  END AS super_categoria,\n",
        "  SUM(total_procedentes) AS total_procedentes,\n",
        "  COUNT(DISTINCT irregularidade) AS qtd_irregularidades\n",
        "FROM\n",
        "  workspace.bacen_gold.top_irregularidades_periodo\n",
        "WHERE\n",
        "  (ano, trimestre) IN (\n",
        "    SELECT\n",
        "      MAX(ano),\n",
        "      MAX(trimestre)\n",
        "    FROM\n",
        "      workspace.bacen_gold.top_irregularidades_periodo\n",
        "    WHERE\n",
        "      ano\n",
        "        = (\n",
        "          SELECT\n",
        "            MAX(ano)\n",
        "          FROM\n",
        "            workspace.bacen_gold.top_irregularidades_periodo\n",
        "        )\n",
        "  )\n",
        "GROUP BY\n",
        "  super_categoria\n",
        "ORDER BY\n",
        "  total_procedentes DESC"
      ]
    }
  ],
